# ClearML credentials / hosts (prefer ~/clearml.conf where practical)
CLEARML_API_ACCESS_KEY="" # empty; set only in your private .env
CLEARML_API_SECRET_KEY="" # empty; set only in your private .env
CLEARML_API_HOST=
CLEARML_WEB_HOST=
CLEARML_FILES_HOST=

# ClearML resources
CLEARML_PROJECT_NAME=
CLEARML_PROJECT_ID=
CLEARML_DATASET_ID=
CLEARML_DATASET_NAME=
CLEARML_DATASET_PROJECT=
CLEARML_QUEUE_NAME=
CLEARML_QUEUE_ID=
CLEARML_WORKER_ID=
CLEARML_DATASET_OUTPUT_URI=

# Private object storage used by legacy model entrypoints
AWS_ENDPOINT_URL=
CLEARML_AWS_S3_CREDENTIALS_0_HOST=
CLEARML_AWS_S3_CREDENTIALS_0_KEY=
CLEARML_AWS_S3_CREDENTIALS_0_SECRET=
CLEARML_AWS_S3_CREDENTIALS_0_SECURE=true
CLEARML_AWS_S3_CREDENTIALS_0_BUCKET=

# Optional task naming
CLEARML_TASK_NAME_FACTORIAL=CDC 2022 to 2023 factorial audit
CLEARML_TASK_NAME_LR_CONVERGENCE=CDC 2022 to 2023 LR convergence rerun
CLEARML_TASK_NAME_ALL_BIRTHS_SENSITIVITY=CDC 2022 to 2023 all-birth sensitivity analysis
CLEARML_TASK_NAME_PROBABILITY_CALIBRATION=

# Project paths
PROJECT_ROOT=
CDC_DATA_ROOT=
CDC_2022_HARMONIZED_PATH=
CDC_2023_HARMONIZED_PATH=
FACTORIAL_DESIGN_DIR=
RESULTS_DIR=

# Runtime infrastructure overrides
EXPERIMENT_CONFIG_PATH=
